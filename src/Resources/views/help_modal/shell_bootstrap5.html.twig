{# Bootstrap 5 — inner structure of .modal (cloned into the modal root by help-modal.js).
   Override in your app: templates/bundles/NowoFormKitBundle/help_modal/shell_bootstrap5.html.twig #}
<div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
        <div class="modal-header">
            <h5 class="modal-title" data-nowo-help-modal-title></h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body" data-nowo-help-modal-body></div>
    </div>
</div>
