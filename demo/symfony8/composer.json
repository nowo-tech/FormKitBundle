{
  "name": "nowo-tech/form-kit-demo-symfony8",
  "description": "Demo for Form Kit Bundle - Symfony 8",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": ">=8.4,<8.6",
    "a2lix/translation-form-bundle": "^4.0",
    "doctrine/collections": "^2.2",
    "friendsofsymfony/ckeditor-bundle": "^2.5",
    "nowo-tech/form-kit-bundle": "@dev",
    "nowo-tech/select-all-choice-bundle": "^1.0",
    "nowo-tech/otp-input-bundle": "@dev",
    "nowo-tech/phone-input-bundle": "@dev",
    "nowo-tech/password-toggle-bundle": "@dev",
    "nowo-tech/password-strength-bundle": "@dev",
    "nowo-tech/icon-selector-bundle": "@dev",
    "nowo-tech/tiptap-editor-bundle": "@dev",
    "nowo-tech/ckeditor5-editor-bundle": "@dev",
    "symfony/http-client": "^8.0",
    "symfony/ux-icons": "^2.9",
    "pentatrion/vite-bundle": "^8.2",
    "symfony/asset": "^8.0",
    "symfony/asset-mapper": "8.1.*",
    "symfony/console": "^8.0",
    "symfony/dotenv": "^8.0",
    "symfony/form": "^8.0",
    "symfony/framework-bundle": "^8.0",
    "symfony/http-kernel": "^8.0",
    "symfony/runtime": "^8.0",
    "symfony/stimulus-bundle": "^2.9",
    "symfony/ux-autocomplete": "^2.24",
    "symfony/twig-bundle": "^8.0",
    "symfony/ux-cropperjs": "^2.0",
    "symfony/ux-dropzone": "^2.0",
    "symfony/validator": "^8.0"
  },
  "require-dev": {
    "nowo-tech/twig-inspector-bundle": "^1.0",
    "sensiolabs/typescript-bundle": "^0.2.2",
    "symfony/debug-bundle": "8.1.*",
    "symfony/web-profiler-bundle": "8.1.*"
  },
  "config": {
    "allow-plugins": {
      "symfony/flex": true,
      "symfony/runtime": true
    },
    "sort-packages": true
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "replace": {
    "symfony/polyfill-ctype": "*",
    "symfony/polyfill-php80": "*",
    "symfony/polyfill-php81": "*",
    "symfony/polyfill-php82": "*"
  },
  "scripts": {
    "auto-scripts": {
      "cache:clear": "@php bin/console cache:clear",
      "ckeditor:install --clear=drop --no-progress-bar": "@php bin/console ckeditor:install --clear=drop --no-progress-bar --tag=4.22.1"
    },
    "post-install-cmd": ["@auto-scripts"],
    "post-update-cmd": ["@auto-scripts"]
  },
  "conflict": {
    "symfony/symfony": "*"
  },
  "extra": {
    "symfony": {
      "allow-contrib": true,
      "require": "8.1.*"
    }
  },
  "repositories": [
    {
      "type": "path",
      "url": "/var/form-kit-bundle",
      "options": {
        "symlink": true
      }
    },
    { "type": "path", "url": "/var/nowo-bundles/OtpInputBundle" },
    { "type": "path", "url": "/var/nowo-bundles/PhoneInputBundle" },
    { "type": "path", "url": "/var/nowo-bundles/PasswordToggleBundle" },
    { "type": "path", "url": "/var/nowo-bundles/PasswordStrengthBundle" },
    { "type": "path", "url": "/var/nowo-bundles/IconSelectorBundle" },
    { "type": "path", "url": "/var/nowo-bundles/TiptapEditorBundle" },
    { "type": "path", "url": "/var/nowo-bundles/Ckeditor5EditorBundle" }
  ],
  "minimum-stability": "dev"
}
