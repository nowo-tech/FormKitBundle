{% extends 'base.html.twig' %}

{% block title %}{{ 'demo_pages.index.title'|trans }}{% endblock %}

{% macro demo_card(title, description, url, button_text) %}
  <div class="col-12 col-md-6 col-lg-4">
    <div class="card form-card h-100">
      <div class="card-body text-center py-4">
        <h2 class="h6 mb-2">{{ title }}</h2>
        <p class="text-secondary small mb-3">{{ description|raw }}</p>
        <a href="{{ url }}" class="btn btn-outline-primary">{{ button_text }}</a>
      </div>
    </div>
  </div>
{% endmacro %}

{% block body %}
{% set locale = app.request.locale %}
<div class="mb-4">
  <h1 class="h3 mb-2">{{ 'demo_pages.index.title'|trans }}</h1>
  <p class="text-secondary mb-0">{{ 'demo_pages.index.intro'|trans }}</p>
</div>

{% set cards = [
  { id: 'form_type', route: 'form_demo_form_type' },
  { id: 'controller_form', route: 'form_demo_controller_form' },
  { id: 'search', route: 'form_demo_search' },
  { id: 'example_form', route: 'form_demo_example_form' },
  { id: 'dropzone', route: 'form_demo_dropzone' },
  { id: 'cropper', route: 'form_demo_cropper' },
  { id: 'translations', route: 'form_demo_translations' },
  { id: 'nested', route: 'form_demo_nested' },
  { id: 'data_transformers', route: 'form_demo_data_transformers' },
  { id: 'choice_fields', route: 'form_demo_choice_fields' },
  { id: 'nowo_special_fields', route: 'form_demo_nowo_special_fields' },
  { id: 'ckeditor', route: 'form_demo_ckeditor' },
  { id: 'ux_autocomplete', route: 'form_demo_ux_autocomplete' },
  { id: 'multistep', route: 'form_demo_multistep' },
] %}

<div class="row g-4">
  {% for c in cards %}
    {{ _self.demo_card(
      ('demo_pages.index_cards.' ~ c.id ~ '.title')|trans,
      ('demo_pages.index_cards.' ~ c.id ~ '.description')|trans|raw,
      path(c.route, {_locale: locale}),
      ('demo_pages.index_cards.' ~ c.id ~ '.button')|trans
    ) }}
  {% endfor %}
</div>
{% endblock %}
