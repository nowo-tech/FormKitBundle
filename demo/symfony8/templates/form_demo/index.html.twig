{% extends 'base.html.twig' %}

{% block title %}{{ 'demo_pages.index.title'|trans }}{% endblock %}

{% set demo_page = 'index' %}

{% block body %}
    {% set locale = app.request.locale %}
    {% set cards = [
        { id: 'form_type', route: 'form_demo_form_type' },
        { id: 'controller_form', route: 'form_demo_controller_form' },
        { id: 'search', route: 'form_demo_search' },
        { id: 'example_form', route: 'form_demo_example_form' },
        { id: 'dropzone', route: 'form_demo_dropzone' },
        { id: 'cropper', route: 'form_demo_cropper' },
        { id: 'translations', route: 'form_demo_translations' },
        { id: 'locale_tabs', route: 'form_demo_locale_tabs' },
        { id: 'nested', route: 'form_demo_nested' },
        { id: 'data_transformers', route: 'form_demo_data_transformers' },
        { id: 'choice_fields', route: 'form_demo_choice_fields' },
        { id: 'conditional_fields', route: 'form_demo_conditional_fields' },
        { id: 'conditional_fields_live', route: 'form_demo_conditional_fields_live' },
        { id: 'kit_api_patterns', route: 'form_demo_kit_api_patterns' },
        { id: 'nowo_special_fields', route: 'form_demo_nowo_special_fields' },
        { id: 'ckeditor', route: 'form_demo_ckeditor' },
        { id: 'ux_autocomplete', route: 'form_demo_ux_autocomplete' },
        { id: 'multistep', route: 'form_demo_multistep' },
    ] %}

    <div class="nowo-ui-cards">
        {% for c in cards %}
            {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: ('demo_pages.index_cards.' ~ c.id ~ '.title')|trans, kind: 'content', card: c} %}
                {% block section_body %}
                    <p class="nowo-ui-muted">{{ ('demo_pages.index_cards.' ~ card.id ~ '.description')|trans|raw }}</p>
                {% endblock %}
                {% block section_footer %}
                    <a href="{{ path(card.route, {_locale: locale}) }}" class="nowo-ui-btn nowo-ui-btn--outline">{{ ('demo_pages.index_cards.' ~ card.id ~ '.button')|trans }}</a>
                {% endblock %}
            {% endembed %}
        {% endfor %}
    </div>
{% endblock %}
