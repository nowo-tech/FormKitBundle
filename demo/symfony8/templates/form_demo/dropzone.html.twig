{% extends 'base.html.twig' %}

{% block title %}{{ 'demo_pages.dropzone.page_title'|trans }}{% endblock %}

{% set demo_page = 'dropzone' %}
{% set demo_flash = uploaded ? {success: [('demo_pages.dropzone.uploaded_prefix'|trans) ~ ': ' ~ uploaded]} : null %}

{% block body %}
    {% if default_image_url %}
        {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'demo_pages.dropzone.default_image_heading'|trans, kind: 'detail'} %}
            {% block section_body %}
                <img src="{{ default_image_url }}" alt="{{ 'demo_pages.dropzone.demo_sample_alt'|trans }}" width="480" loading="lazy">
            {% endblock %}
        {% endembed %}
    {% endif %}

    {{ include('form_demo/_form_card.html.twig', {demo_form: form, card_title: 'demo_pages.dropzone.heading'|trans, actions: [{label: 'demo_pages.dropzone.upload_button'|trans, primary: true}], render_rest: true}, false) }}
{% endblock %}
