{% extends 'base.html.twig' %}

{% block title %}{{ 'demo_pages.dropzone.page_title'|trans }}{% endblock %}

{% block body %}
{% set locale = app.request.locale %}
<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="h3 mb-0">{{ 'demo_pages.dropzone.heading'|trans }}</h1>
  <a class="btn btn-sm btn-outline-secondary" href="{{ path('form_demo_index', {_locale: locale}) }}">{{ 'demo_pages.common.back'|trans }}</a>
</div>
<p class="text-secondary mb-4">{{ 'demo_pages.dropzone.intro'|trans|raw }}</p>

{% if default_image_url %}
  <div class="card form-card shadow-sm mb-4">
    <div class="card-body p-4">
      <h2 class="h6 text-muted mb-2">{{ 'demo_pages.dropzone.default_image_heading'|trans }}</h2>
      <img src="{{ default_image_url }}" alt="{{ 'demo_pages.dropzone.demo_sample_alt'|trans }}" class="img-fluid rounded" style="max-height: 280px; object-fit: contain;">
    </div>
  </div>
{% endif %}

<div class="card form-card shadow-sm">
  <div class="card-body p-4">
    {{ form_start(form) }}
    {{ form_row(form.document) }}
    {% set form_buttons %}
      <button type="submit" class="btn btn-primary">{{ 'demo_pages.dropzone.upload_button'|trans }}</button>
    {% endset %}
    <div class="form-kit-buttons">{{ form_buttons|raw }}</div>
    {{ form_end(form, { render_rest: false }) }}
  </div>
</div>

{% if uploaded %}
  <div class="alert alert-success mt-4 mb-0 shadow-sm">
    <strong>{{ 'demo_pages.dropzone.uploaded_prefix'|trans }}:</strong> <code>{{ uploaded }}</code>
  </div>
{% endif %}
{% endblock %}
