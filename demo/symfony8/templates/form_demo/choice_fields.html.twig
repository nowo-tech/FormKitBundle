{% extends 'base.html.twig' %}

{% block title %}{{ 'demo_pages.choice_fields.page_title'|trans }}{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('/bundles/nowoformkit/field-widgets.css') }}">
{% endblock %}

{% block page_scripts %}
    <script defer src="{{ asset('char-counter.js', 'nowo_form_kit') }}"></script>
{% endblock %}

{% set demo_page = 'choice_fields' %}

{% block body %}
    {{ include('form_demo/_usage.html.twig', {page: 'choice_fields', count: 3}, false) }}
    {{ include('form_demo/_form_card.html.twig', {demo_form: form, card_title: 'demo_pages.choice_fields.heading'|trans}, false) }}
    {% if submitted %}
        {{ include('form_demo/_result.html.twig', {result_title: 'demo_pages.choice_fields.normalized_title'|trans, data: submitted}, false) }}
    {% endif %}
{% endblock %}
