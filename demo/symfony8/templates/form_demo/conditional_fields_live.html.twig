{% extends 'base.html.twig' %}

{% block title %}{{ 'demo_pages.conditional_fields_live.page_title'|trans }}{% endblock %}

{% block body %}
{% set locale = app.request.locale %}
<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="h3 mb-0">{{ 'demo_pages.conditional_fields_live.heading'|trans }}</h1>
  <a class="btn btn-sm btn-outline-secondary" href="{{ path('form_demo_index', {_locale: locale}) }}">{{ 'demo_pages.common.back'|trans }}</a>
</div>
<p class="text-secondary mb-2">{{ 'demo_pages.conditional_fields_live.intro'|trans|raw }}</p>
<ul class="small text-secondary mb-4">
  <li>{{ 'demo_pages.conditional_fields_live.usage_1'|trans|raw }}</li>
  <li>{{ 'demo_pages.conditional_fields_live.usage_2'|trans|raw }}</li>
  <li>{{ 'demo_pages.conditional_fields_live.usage_3'|trans|raw }}</li>
</ul>

<div class="card form-card shadow-sm">
  <div class="card-body p-4">
    {{ component('ConditionalFieldsLive') }}
  </div>
</div>
{% endblock %}
