{% extends 'base.html.twig' %}

{% block title %}{{ 'demo_pages.example.page_title'|trans }}{% endblock %}

{% set demo_page = 'example' %}
{% set demo_flash = submitted ? {success: [('demo_pages.common.submitted'|trans) ~ ': ' ~ ('demo_pages.example.submitted_line'|trans({ '%name%': submitted.name, '%email%': submitted.email, '%subject%': submitted.subject }))]} : null %}

{% block body %}
    {{ include('form_demo/_form_card.html.twig', {
        demo_form: form,
        card_title: 'demo_pages.example.heading'|trans,
        actions: [
            {label: 'demo_pages.example.send'|trans, name: 'action', value: 'send', primary: true},
            {label: 'demo_pages.example.send_copy'|trans, name: 'action', value: 'send_copy', primary: false},
        ],
    }, false) }}
{% endblock %}
