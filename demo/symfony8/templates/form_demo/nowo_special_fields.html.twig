{% extends 'base.html.twig' %}

{% block title %}{{ 'demo_pages.nowo_special_fields.page_title'|trans }}{% endblock %}

{% block stylesheets %}
<link rel="stylesheet" href="{{ asset('/bundles/nowophoneinput/css/flag-icons.min.css') }}">
<link rel="stylesheet" href="{{ asset('/bundles/nowophoneinput/css/phone_input.css') }}">
<link rel="stylesheet" href="{{ asset('/bundles/nowopasswordtoggle/css/toggle_password.css') }}">
<link rel="stylesheet" href="{{ asset('tag-input.css', 'nowo_tag_input') }}">
<link rel="stylesheet" href="{{ asset('slide-to-confirm.css', 'nowo_slide_to_confirm') }}">
{% endblock %}

{% block body %}
{% set locale = app.request.locale %}
<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="h3 mb-0">{{ 'demo_pages.nowo_special_fields.heading'|trans }}</h1>
  <a class="btn btn-sm btn-outline-secondary" href="{{ path('form_demo_index', {_locale: locale}) }}">{{ 'demo_pages.common.back'|trans }}</a>
</div>
<p class="text-secondary mb-2">{{ 'demo_pages.nowo_special_fields.intro'|trans|raw }}</p>
<ul class="small text-secondary mb-4">
  <li>{{ 'demo_pages.nowo_special_fields.usage_1'|trans|raw }}</li>
  <li>{{ 'demo_pages.nowo_special_fields.usage_2'|trans|raw }}</li>
  <li>{{ 'demo_pages.nowo_special_fields.usage_3'|trans|raw }}</li>
</ul>

<div class="card form-card shadow-sm">
  <div class="card-body p-4">
    {% form_theme form 'form_demo/nowo_special_fields_form_theme.html.twig' %}
    {{ form_start(form) }}
    {% set columns = {verificationCode: 'col-12 col-md-6', mobilePhone: 'col-12 col-md-6', secretPassword: 'col-12 col-md-6', strengthOnlyPassword: 'col-12 col-md-6'} %}
    <div class="row g-3">
      {% for child in form %}
        {% if not child.rendered %}
          {% if 'hidden' in child.vars.block_prefixes %}
            {{ form_row(child) }}
          {% else %}
            <div class="{{ columns[child.vars.name]|default('col-12') }}">{{ form_row(child) }}</div>
          {% endif %}
        {% endif %}
      {% endfor %}
    </div>
    <div class="form-kit-buttons mt-2">
      <button type="submit" class="btn btn-primary">{{ 'demo_pages.common.submit'|trans }}</button>
    </div>
    {{ form_end(form) }}
  </div>
</div>

{% if submitted %}
  <div class="mt-4">
    <p class="fw-semibold mb-2">{{ 'demo_pages.nowo_special_fields.normalized_title'|trans }}</p>
    <pre class="bg-light border rounded p-3 small mb-0 overflow-auto">{{ submitted|json_encode(constant('JSON_PRETTY_PRINT')) }}</pre>
  </div>
{% endif %}
{% endblock %}

{% block page_scripts %}
{# Root-relative URLs (/bundles/...) — never locale-relative (/en/bundles/...). Load after Stimulus importmap. #}
<script defer src="{{ asset('/bundles/nowootpinput/otp-input.js') }}"></script>
<script defer src="{{ asset(nowo_icon_selector_asset_path('icon-selector.js'), 'nowo_icon_selector') }}"></script>
<script defer src="{{ asset(nowo_tiptap_editor_asset_path('tiptap-editor.js'), nowo_tiptap_editor_asset_package()) }}"></script>
<script defer src="{{ asset(nowo_ckeditor5_editor_asset_path('ckeditor5-editor.js'), nowo_ckeditor5_editor_asset_package()) }}"></script>
<script defer src="{{ asset('password-strength.js', 'nowo_password_strength') }}"></script>
<script defer src="{{ asset('tag-input.js', 'nowo_tag_input') }}"></script>
<script defer src="{{ asset('slide-to-confirm.js', 'nowo_slide_to_confirm') }}"></script>
{% endblock %}
