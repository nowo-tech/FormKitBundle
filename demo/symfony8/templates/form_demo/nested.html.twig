{% extends 'base.html.twig' %}

{% block title %}{{ 'demo_pages.nested.page_title'|trans }}{% endblock %}

{% set demo_page = 'nested' %}
{% set demo_flash = submitted ? {success: [('demo_pages.common.submitted'|trans) ~ ': ' ~ submitted.fullName ~ ', ' ~ submitted.email ~ ' — ' ~ submitted.address.street ~ ' ' ~ submitted.address.number ~ ', ' ~ submitted.address.postalCode ~ ' ' ~ submitted.address.city ~ ', ' ~ submitted.address.province]} : null %}

{% block body %}
    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'demo_pages.nested.heading'|trans, kind: 'form'} %}
        {% block section_body %}
            {{ form_start(form, {attr: {id: 'demo-form', class: 'nowo-ui-form'}}) }}
            {#
              Child loop (REQ-TWIG-003): sections open at the field named in `sections`; the embedded address form is looped
              in place.
            #}
            {% set sections = {fullName: 'demo_pages.nested.section_contact', address: 'demo_pages.nested.section_address'} %}
            {% set _open = false %}
            {% for child in form %}
                {% if not child.rendered %}
                    {% if 'hidden' in child.vars.block_prefixes %}
                        {{ form_row(child) }}
                    {% else %}
                        {% if sections[child.vars.name] is defined %}
                            {% if _open %}</fieldset>{% endif %}
                            <fieldset class="nowo-ui-fieldset">
                                <legend class="nowo-ui-fieldset__legend">{{ sections[child.vars.name]|trans }}</legend>
                            {% set _open = true %}
                        {% endif %}
                        {% for field in (child.vars.compound and child.children is not empty ? child : [child]) %}
                            {% if not field.rendered %}
                                {{ form_row(field) }}
                            {% endif %}
                        {% endfor %}
                    {% endif %}
                {% endif %}
            {% endfor %}
            {% if _open %}</fieldset>{% endif %}
            {{ form_end(form) }}
        {% endblock %}
        {% block section_footer %}
            <button type="submit" form="demo-form" class="nowo-ui-btn nowo-ui-btn--primary">{{ 'demo_pages.common.save'|trans }}</button>
        {% endblock %}
    {% endembed %}
{% endblock %}
