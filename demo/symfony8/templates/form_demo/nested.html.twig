{% extends 'base.html.twig' %}

{% block title %}{{ 'demo_pages.nested.page_title'|trans }}{% endblock %}

{% block body %}
{% set locale = app.request.locale %}
<div class="nowo-ui-page-header">
  <h1 class="nowo-ui-page-header__title">{{ 'demo_pages.nested.heading'|trans }}</h1>
  <a class="nowo-ui-btn nowo-ui-btn--sm nowo-ui-btn--outline" href="{{ path('form_demo_index', {_locale: locale}) }}">{{ 'demo_pages.common.back'|trans }}</a>
</div>
<p class="nowo-ui-muted">{{ 'demo_pages.nested.intro'|trans|raw }}</p>

<div class="nowo-ui-card">
  <div class="nowo-ui-card__body">
    {{ form_start(form, {attr: {class: 'nowo-ui-form'}}) }}
    {#
      Child loop (REQ-TWIG-003): sections open at the field named in `sections`; the embedded address form is looped
      in place.
    #}
    {% set sections = {fullName: 'demo_pages.nested.section_contact', address: 'demo_pages.nested.section_address'} %}
    {% for child in form %}
      {% if not child.rendered %}
        {% if 'hidden' in child.vars.block_prefixes %}
          {{ form_row(child) }}
        {% else %}
          {% if sections[child.vars.name] is defined %}
            {% if not loop.first %}
      </div>
    </div>
            {% endif %}
    <div>
      <h2>{{ sections[child.vars.name]|trans }}</h2>
      <div>
          {% endif %}
          {% for field in (child.vars.compound and child.children is not empty ? child : [child]) %}
            {% if not field.rendered %}
        {{ form_row(field) }}
            {% endif %}
          {% endfor %}
        {% endif %}
      {% endif %}
    {% endfor %}
      </div>
    </div>
    <div class="nowo-ui-form__actions">
      <button type="submit" class="nowo-ui-btn nowo-ui-btn--primary">{{ 'demo_pages.common.save'|trans }}</button>
    </div>
    {{ form_end(form) }}
  </div>
</div>

{% if submitted %}
  <div class="nowo-ui-flash nowo-ui-flash--success">
    <strong>{{ 'demo_pages.common.submitted'|trans }}:</strong>
    {{ submitted.fullName }}, {{ submitted.email }} — {{ submitted.address.street }} {{ submitted.address.number }}, {{ submitted.address.postalCode }} {{ submitted.address.city }}, {{ submitted.address.province }}
  </div>
{% endif %}
{% endblock %}
