{% extends 'base.html.twig' %}

{% block title %}{{ 'demo_pages.nested.page_title'|trans }}{% endblock %}

{% block body %}
{% set locale = app.request.locale %}
<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="h3 mb-0">{{ 'demo_pages.nested.heading'|trans }}</h1>
  <a class="btn btn-sm btn-outline-secondary" href="{{ path('form_demo_index', {_locale: locale}) }}">{{ 'demo_pages.common.back'|trans }}</a>
</div>
<p class="text-secondary mb-4">{{ 'demo_pages.nested.intro'|trans|raw }}</p>

<div class="card form-card shadow-sm">
  <div class="card-body p-4">
    {{ form_start(form) }}
    {#
      Child loop (REQ-TWIG-003): sections open at the field named in `sections`; the embedded address form is looped
      in place so its fields keep their own grid columns (`columns`, default col-12).
    #}
    {% set sections = {fullName: 'demo_pages.nested.section_contact', address: 'demo_pages.nested.section_address'} %}
    {% set columns = {
      fullName: 'col-12 col-md-6',
      email: 'col-12 col-md-6',
      number: 'col-12 col-md-4',
      floor: 'col-12 col-md-4',
      postalCode: 'col-12 col-md-4',
      city: 'col-12 col-md-6',
      province: 'col-12 col-md-6',
    } %}
    {% for child in form %}
      {% if not child.rendered %}
        {% if 'hidden' in child.vars.block_prefixes %}
          {{ form_row(child) }}
        {% else %}
          {% if sections[child.vars.name] is defined %}
            {% if not loop.first %}
      </div>
    </div>
            {% endif %}
    <div class="form-section">
      <h2 class="form-section-title">{{ sections[child.vars.name]|trans }}</h2>
      <div class="row g-3">
          {% endif %}
          {% for field in (child.vars.compound and child.children is not empty ? child : [child]) %}
            {% if not field.rendered %}
        <div class="{{ columns[field.vars.name]|default('col-12') }}">{{ form_row(field) }}</div>
            {% endif %}
          {% endfor %}
        {% endif %}
      {% endif %}
    {% endfor %}
      </div>
    </div>
    <div class="form-kit-buttons">
      <button type="submit" class="btn btn-primary">{{ 'demo_pages.common.save'|trans }}</button>
    </div>
    {{ form_end(form) }}
  </div>
</div>

{% if submitted %}
  <div class="alert alert-success mt-4 mb-0 shadow-sm">
    <strong>{{ 'demo_pages.common.submitted'|trans }}:</strong>
    {{ submitted.fullName }}, {{ submitted.email }} — {{ submitted.address.street }} {{ submitted.address.number }}, {{ submitted.address.postalCode }} {{ submitted.address.city }}, {{ submitted.address.province }}
  </div>
{% endif %}
{% endblock %}
