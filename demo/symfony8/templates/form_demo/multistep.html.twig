{% extends 'base.html.twig' %}

{% block title %}{{ 'demo_pages.multistep.page_title'|trans }}{% endblock %}

{% set demo_page = 'multistep' %}

{% block body %}
    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'demo_pages.multistep.heading'|trans, kind: 'form'} %}
        {% block section_body %}
            <ol class="nowo-ui-wizard-steps">
                {% for key in wizard.stepKeys %}
                    <li class="nowo-ui-wizard-steps__item{{ key == wizard.currentStepKey ? ' nowo-ui-wizard-steps__item--active' : '' }}{{ loop.index0 < wizard.currentIndex ? ' nowo-ui-wizard-steps__item--done' : '' }}"{% if key == wizard.currentStepKey %} aria-current="step"{% endif %}>{{ ('demo_wizard_nav.' ~ key)|trans }}</li>
                {% endfor %}
            </ol>

            {{ form_start(form, {attr: {id: 'demo-form', class: 'nowo-ui-form'}}) }}
            {% for child in form %}
                {% if not child.rendered %}
                    {{ form_row(child) }}
                {% endif %}
            {% endfor %}
            {{ form_end(form, { render_rest: false }) }}
        {% endblock %}
        {% block section_footer %}
            <button type="submit" form="demo-form" class="nowo-ui-btn nowo-ui-btn--primary">{{ wizard.currentIndex + 1 >= wizard.stepKeys|length ? ('demo_pages.common.finish'|trans) : ('demo_pages.common.next'|trans) }}</button>
        {% endblock %}
    {% endembed %}
{% endblock %}
