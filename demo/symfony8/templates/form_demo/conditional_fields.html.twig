{% extends 'base.html.twig' %}

{% block title %}{{ 'demo_pages.conditional_fields.page_title'|trans }}{% endblock %}

{% set demo_page = 'conditional_fields' %}

{% block body %}
    {% set locale = app.request.locale %}
    {{ include('form_demo/_usage.html.twig', {page: 'conditional_fields', count: 3}, false) }}

    {{ include('form_demo/_form_card.html.twig', {
        demo_form: form,
        form_id: 'demo-form-events',
        card_title: 'demo_pages.conditional_fields.events_heading'|trans,
        card_intro: 'demo_pages.conditional_fields.events_intro'|trans|striptags|raw,
        actions: [{label: 'demo_pages.common.submit'|trans, name: 'events_submit', primary: true}],
    }, false) }}
    {% if submitted %}
        {{ include('form_demo/_result.html.twig', {result_title: 'demo_pages.common.submitted'|trans, data: submitted}, false) }}
    {% endif %}

    {% set _build_modes %}
        <div role="group" aria-label="{{ 'demo_pages.conditional_fields.build_heading'|trans }}">
            <a class="nowo-ui-btn nowo-ui-btn--outline nowo-ui-btn--sm"{% if build_mode == 'individual' %} aria-current="true"{% endif %} href="{{ path('form_demo_conditional_fields', {_locale: locale, account_mode: 'individual'}) }}">Individual</a>
            <a class="nowo-ui-btn nowo-ui-btn--outline nowo-ui-btn--sm"{% if build_mode == 'company' %} aria-current="true"{% endif %} href="{{ path('form_demo_conditional_fields', {_locale: locale, account_mode: 'company'}) }}">Company</a>
        </div>
    {% endset %}
    {{ include('form_demo/_form_card.html.twig', {
        demo_form: build_form,
        form_id: 'demo-form-build',
        card_title: 'demo_pages.conditional_fields.build_heading'|trans,
        card_intro: 'demo_pages.conditional_fields.build_intro'|trans|striptags|raw,
        card_actions: _build_modes,
        actions: [{label: 'demo_pages.common.submit'|trans, name: 'build_submit', primary: false}],
    }, false) }}
    {% if build_submitted %}
        {{ include('form_demo/_result.html.twig', {result_title: 'demo_pages.common.submitted'|trans, data: build_submitted}, false) }}
    {% endif %}
{% endblock %}
