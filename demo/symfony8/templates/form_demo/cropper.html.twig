{% extends 'base.html.twig' %}

{% block title %}{{ 'demo_pages.cropper.page_title'|trans }}{% endblock %}

{% block body %}
{% set locale = app.request.locale %}
<div class="nowo-ui-page-header">
  <h1 class="nowo-ui-page-header__title">{{ 'demo_pages.cropper.heading'|trans }}</h1>
  <a class="nowo-ui-btn nowo-ui-btn--sm nowo-ui-btn--outline" href="{{ path('form_demo_index', {_locale: locale}) }}">{{ 'demo_pages.common.back'|trans }}</a>
</div>
<p class="nowo-ui-muted">{{ 'demo_pages.cropper.intro'|trans|raw }}</p>

{% if not sample_exists %}
  <div class="nowo-ui-flash nowo-ui-flash--warning">
    <strong>{{ 'demo_pages.cropper.sample_missing_title'|trans }}</strong> {{ 'demo_pages.cropper.sample_missing_body'|trans|raw }}
  </div>
  <p class="nowo-ui-muted">{{ 'demo_pages.cropper.expected_path'|trans }} <code class="nowo-ui-code">{{ image_path }}</code></p>
{% else %}
  <div class="nowo-ui-card">
    <div class="nowo-ui-card__body">
      {{ form_start(form, {attr: {class: 'nowo-ui-form'}}) }}
      {% for child in form %}
        {% if not child.rendered %}
          {{ form_row(child) }}
        {% endif %}
      {% endfor %}
      {% set form_buttons %}
        <button type="submit" class="nowo-ui-btn nowo-ui-btn--primary">{{ 'demo_pages.common.crop'|trans }}</button>
      {% endset %}
      <div class="nowo-ui-form__actions">{{ form_buttons|raw }}</div>
      {{ form_end(form) }}
    </div>
  </div>

  {% if submitted %}
    <div class="nowo-ui-flash nowo-ui-flash--success">
      <strong>{{ 'demo_pages.cropper.crop_submitted_title'|trans }}</strong> {{ 'demo_pages.cropper.crop_submitted_body'|trans|raw }}
    </div>
  {% endif %}
{% endif %}
{% endblock %}
