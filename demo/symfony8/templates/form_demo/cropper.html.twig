{% extends 'base.html.twig' %}

{% block title %}{{ 'demo_pages.cropper.page_title'|trans }}{% endblock %}

{% set demo_page = 'cropper' %}
{% set demo_flash = not sample_exists
    ? {warning: [('demo_pages.cropper.sample_missing_title'|trans) ~ ' ' ~ ('demo_pages.cropper.sample_missing_body'|trans|striptags)]}
    : (submitted ? {success: [('demo_pages.cropper.crop_submitted_title'|trans) ~ ' ' ~ ('demo_pages.cropper.crop_submitted_body'|trans|striptags)]} : null) %}

{% block body %}
    {% if not sample_exists %}
        {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'demo_pages.cropper.heading'|trans, kind: 'detail'} %}
            {% block section_body %}
                <p>{{ 'demo_pages.cropper.expected_path'|trans }} <code class="nowo-ui-code">{{ image_path }}</code></p>
            {% endblock %}
        {% endembed %}
    {% else %}
        {{ include('form_demo/_form_card.html.twig', {demo_form: form, card_title: 'demo_pages.cropper.heading'|trans, actions: [{label: 'demo_pages.common.crop'|trans, primary: true}]}, false) }}
    {% endif %}
{% endblock %}
