{% extends 'base.html.twig' %}

{% block title %}{{ 'demo_pages.search.page_title'|trans }}{% endblock %}

{% set demo_page = 'search' %}
{% set demo_flash = submitted ? {info: [('demo_pages.common.submitted'|trans) ~ ': q = ' ~ submitted.q ~ ', category = ' ~ submitted.category]} : null %}

{% block body %}
    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'demo_pages.search.heading'|trans, kind: 'form'} %}
        {% block section_body %}
            {{ form_start(form, {attr: {id: 'demo-form', class: 'nowo-ui-form'}}) }}
            <label for="{{ form.q.vars.id }}">{{ 'search_form.q.label'|trans }}</label>
            <div role="group" aria-label="{{ 'demo_pages.search.heading'|trans }}">
                {{ form_widget(form.q, { attr: { class: 'nowo-ui-input', 'aria-label': ('demo_pages.search.aria_query'|trans) } }) }}
                <span>{{ 'demo_pages.search.in_word'|trans }}</span>
                {{ form_widget(form.category, { attr: { class: 'nowo-ui-input', 'aria-label': ('demo_pages.search.aria_category'|trans) } }) }}
            </div>
            {{ form_errors(form.q) }}
            {{ form_errors(form.category) }}
            {% if form.category.vars.help is defined and form.category.vars.help %}
                <p class="nowo-ui-muted">{{ form.category.vars.help }}</p>
            {% endif %}
            {# Rule 3 (REQ-TWIG-003): q and category are placed in the input group above; the loop renders the rest. #}
            {% for child in form %}
                {% if not child.rendered %}
                    {{ form_row(child) }}
                {% endif %}
            {% endfor %}
            {{ form_end(form) }}
        {% endblock %}
        {% block section_footer %}
            <button type="submit" form="demo-form" class="nowo-ui-btn nowo-ui-btn--primary">{{ 'demo_pages.search.button_submit'|trans }}</button>
        {% endblock %}
    {% endembed %}
{% endblock %}
