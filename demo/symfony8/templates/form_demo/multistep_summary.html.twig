{% extends 'base.html.twig' %}

{% block title %}{{ 'demo_pages.multistep_summary.page_title'|trans }}{% endblock %}

{% set demo_page = 'multistep_summary' %}

{% block body %}
    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'demo_pages.common.collected_data'|trans, kind: 'detail'} %}
        {% block section_body %}
            <dl class="nowo-ui-detail-list">
                {% for key, value in wizard.collectedDataFlat %}
                    <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">{{ key }}</dt><dd class="nowo-ui-detail-list__value">{{ value }}</dd></div>
                {% endfor %}
            </dl>
        {% endblock %}
        {% block section_footer %}
            <a href="{{ path('form_demo_multistep', {_locale: app.request.locale}) }}?reset=1" class="nowo-ui-btn nowo-ui-btn--outline">{{ 'demo_pages.common.start_over'|trans }}</a>
        {% endblock %}
    {% endembed %}
{% endblock %}
