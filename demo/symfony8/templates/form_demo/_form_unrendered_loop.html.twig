{# Reusable renderer: prints only fields not rendered yet. Layout comes from row_attr on each field (FormType/controller). #}
{% set _start = form_start_options|default({}) %}
{{ form_start(demo_form, _start|merge({attr: (_start.attr|default({}))|merge({class: 'nowo-ui-form'})})) }}
  {% for child in demo_form %}
    {% if not child.rendered %}
      {{ form_row(child) }}
    {% endif %}
  {% endfor %}
{% if submit_buttons is defined and submit_buttons is not empty %}
  <div class="nowo-ui-form__actions">{{ submit_buttons|raw }}</div>
{% else %}
  <div class="nowo-ui-form__actions">
    <button type="submit" class="{{ submit_class|default('nowo-ui-btn nowo-ui-btn--primary') }}">{{ submit_label|default('Submit') }}</button>
  </div>
{% endif %}
{{ form_end(demo_form, { render_rest: false }) }}
