{% extends 'base.html.twig' %}

{% block title %}{{ 'demo_pages.form_type.page_title'|trans }}{% endblock %}

{% block body %}
{% set locale = app.request.locale %}
<div class="nowo-ui-page-header">
  <h1 class="nowo-ui-page-header__title">{{ 'demo_pages.form_type.heading'|trans }}</h1>
  <a class="nowo-ui-btn nowo-ui-btn--sm nowo-ui-btn--outline" href="{{ path('form_demo_index', {_locale: locale}) }}">{{ 'demo_pages.common.back'|trans }}</a>
</div>
<p class="nowo-ui-muted">{{ 'demo_pages.form_type.intro'|trans|raw }}</p>

<div class="nowo-ui-flash nowo-ui-flash--info">
  <strong>{{ 'demo_pages.common.bundle_usage'|trans }}</strong>
  <ul class="nowo-ui-muted">
    <li>{{ 'demo_pages.form_type.usage_1'|trans|raw }}</li>
    <li>{{ 'demo_pages.form_type.usage_2'|trans|raw }}</li>
    <li>{{ 'demo_pages.form_type.usage_3'|trans|raw }}</li>
  </ul>
</div>

{% set form_sections = [
  { title: 'Contact', fields: ['full_name', 'email_address', 'message', '_notice_contact', '_sep_details'] },
  { title: 'Details', fields: ['password', 'website', 'age', 'score', 'topic', '_sep_terms', '_terms_notice'] },
  { title: 'Terms', fields: ['accept_terms'] }
] %}
<div class="nowo-ui-card">
  <div class="nowo-ui-card__body">
    {% include 'form_demo/_form_sections_loop.html.twig' with { demo_form: form, sections: form_sections, submit_label: 'demo_pages.common.submit'|trans } only %}
  </div>
</div>
{% endblock %}
