{% extends 'base.html.twig' %}

{% block title %}{{ 'demo_pages.form_type.page_title'|trans }}{% endblock %}

{% block body %}
{% set locale = app.request.locale %}
<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="h3 mb-0">{{ 'demo_pages.form_type.heading'|trans }}</h1>
  <a class="btn btn-sm btn-outline-secondary" href="{{ path('form_demo_index', {_locale: locale}) }}">{{ 'demo_pages.common.back'|trans }}</a>
</div>
<p class="text-secondary mb-4">{{ 'demo_pages.form_type.intro'|trans|raw }}</p>

<div class="alert alert-light border mb-4">
  <strong class="d-block mb-2">{{ 'demo_pages.common.bundle_usage'|trans }}</strong>
  <ul class="mb-0 small text-secondary">
    <li>{{ 'demo_pages.form_type.usage_1'|trans|raw }}</li>
    <li>{{ 'demo_pages.form_type.usage_2'|trans|raw }}</li>
    <li>{{ 'demo_pages.form_type.usage_3'|trans|raw }}</li>
  </ul>
</div>

{% set form_sections = [
  { title: 'Contact', fields: ['full_name', 'email_address', 'message', '_notice_contact', '_sep_details'] },
  { title: 'Details', fields: ['password', 'website', 'age', 'score', 'topic', '_sep_terms', '_terms_notice'] },
  { title: 'Terms', fields: ['accept_terms'] }
] %}
<div class="card form-card shadow-sm">
  <div class="card-body p-4">
    {% include 'form_demo/_form_sections_loop.html.twig' with { demo_form: form, sections: form_sections, submit_label: 'demo_pages.common.submit'|trans } only %}
  </div>
</div>
{% endblock %}
