{% extends 'base.html.twig' %}

{% block title %}{{ 'demo_pages.kit_api_patterns.page_title'|trans }}{% endblock %}

{% set demo_page = 'kit_api_patterns' %}

{% block body %}
    {{ include('form_demo/_usage.html.twig', {page: 'kit_api_patterns', count: 3}, false) }}

    {{ include('form_demo/_form_card.html.twig', {
        demo_form: snake_form,
        form_id: 'demo-form-snake',
        card_title: 'demo_pages.kit_api_patterns.snake_heading'|trans,
        card_intro: 'demo_pages.kit_api_patterns.snake_intro'|trans|striptags|raw,
        actions: [{label: 'demo_pages.common.submit'|trans, name: 'snake_submit', primary: true}],
        render_rest: false,
    }, false) }}
    {% if snake_submitted %}
        {{ include('form_demo/_result.html.twig', {result_title: 'demo_pages.common.submitted'|trans, data: snake_submitted}, false) }}
    {% endif %}

    {{ include('form_demo/_form_card.html.twig', {
        demo_form: named_form,
        form_id: 'demo-form-named',
        card_title: 'demo_pages.kit_api_patterns.named_heading'|trans,
        card_intro: 'demo_pages.kit_api_patterns.named_intro'|trans|striptags|raw,
        actions: [{label: 'demo_pages.common.submit'|trans, name: 'named_submit', primary: false}],
        render_rest: false,
    }, false) }}
    {% if named_submitted %}
        {{ include('form_demo/_result.html.twig', {result_title: 'demo_pages.common.submitted'|trans, data: named_submitted}, false) }}
    {% endif %}
{% endblock %}
