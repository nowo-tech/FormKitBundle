{% extends 'base.html.twig' %}

{% block title %}{{ 'demo_pages.kit_api_patterns.page_title'|trans }}{% endblock %}

{% block body %}
{% set locale = app.request.locale %}
<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="h3 mb-0">{{ 'demo_pages.kit_api_patterns.heading'|trans }}</h1>
  <a class="btn btn-sm btn-outline-secondary" href="{{ path('form_demo_index', {_locale: locale}) }}">{{ 'demo_pages.common.back'|trans }}</a>
</div>
<p class="text-secondary mb-2">{{ 'demo_pages.kit_api_patterns.intro'|trans|raw }}</p>
<ul class="small text-secondary mb-4">
  <li>{{ 'demo_pages.kit_api_patterns.usage_1'|trans|raw }}</li>
  <li>{{ 'demo_pages.kit_api_patterns.usage_2'|trans|raw }}</li>
  <li>{{ 'demo_pages.kit_api_patterns.usage_3'|trans|raw }}</li>
</ul>

<div class="row g-4">
  <div class="col-12 col-lg-6">
    <div class="card form-card shadow-sm h-100">
      <div class="card-body p-4">
        <h2 class="h5 mb-3">{{ 'demo_pages.kit_api_patterns.snake_heading'|trans }}</h2>
        <p class="small text-secondary mb-3">{{ 'demo_pages.kit_api_patterns.snake_intro'|trans|raw }}</p>
        {{ form_start(snake_form) }}
        <div class="row g-3">
          {{ form_row(snake_form.full_name) }}
          {{ form_row(snake_form.email_address) }}
          {{ form_row(snake_form.topic) }}
          {{ form_row(snake_form.notes) }}
          {{ form_row(snake_form.priority) }}
        </div>
        {{ form_rest(snake_form) }}
        <div class="form-kit-buttons mt-3">
          <button type="submit" name="snake_submit" class="btn btn-primary">{{ 'demo_pages.common.submit'|trans }}</button>
        </div>
        {{ form_end(snake_form, { render_rest: false }) }}
        {% if snake_submitted %}
          <pre class="bg-light border rounded p-3 small mt-3 mb-0 overflow-auto">{{ snake_submitted|json_encode(constant('JSON_PRETTY_PRINT')) }}</pre>
        {% endif %}
      </div>
    </div>
  </div>
  <div class="col-12 col-lg-6">
    <div class="card form-card shadow-sm h-100">
      <div class="card-body p-4">
        <h2 class="h5 mb-3">{{ 'demo_pages.kit_api_patterns.named_heading'|trans }}</h2>
        <p class="small text-secondary mb-3">{{ 'demo_pages.kit_api_patterns.named_intro'|trans|raw }}</p>
        {{ form_start(named_form) }}
        <div class="row g-3">
          {{ form_row(named_form.title) }}
          {{ form_row(named_form.summary) }}
          {{ form_row(named_form.internal_code) }}
        </div>
        {{ form_rest(named_form) }}
        <div class="form-kit-buttons mt-3">
          <button type="submit" name="named_submit" class="btn btn-primary">{{ 'demo_pages.common.submit'|trans }}</button>
        </div>
        {{ form_end(named_form, { render_rest: false }) }}
        {% if named_submitted %}
          <pre class="bg-light border rounded p-3 small mt-3 mb-0 overflow-auto">{{ named_submitted|json_encode(constant('JSON_PRETTY_PRINT')) }}</pre>
        {% endif %}
      </div>
    </div>
  </div>
</div>
{% endblock %}
