{#- REQ-DEMO-014: the demo shell is UiKit's admin layout with UiKit's default theme (nowo-ui.css from the bundle's own
    asset package, no CSS framework, no CDN, inline SVG icons). The Form Kit help modal uses its self-contained shell. -#}
{% extends '@NowoUiKit/layout/admin.html.twig' %}

{% block nowo_ui_document_title %}{% block title %}{{ 'demo_pages.layout.default_title'|trans }}{% endblock %}{% endblock %}

{% block nowo_ui_head %}
    {# Form Kit help modal: per-request nonce that binds label[data-nowo-help-modal] payloads to this page (REQ-SEC-004). #}
    {{ nowo_form_kit_help_modal_meta() }}
{% endblock %}

{% block nowo_ui_styles %}
    {{ parent() }}
    {{ vite_entry_link_tags('app') }}
    {% block stylesheets %}{% endblock %}
{% endblock %}

{% block nowo_ui_navigation %}
    {% set route = app.request.attributes.get('_route') %}
    {% set locale = app.request.locale %}
    {% set route_params = app.request.attributes.get('_route_params')|default({}) %}
    {% set _locales = [] %}
    {% for loc in demo_enabled_locales %}
        {% set _locales = _locales|merge([{
            code: loc,
            label: loc|upper,
            href: route ? path(route, route_params|merge({_locale: loc})) : path('form_demo_index', {_locale: loc}),
            current: loc == locale,
        }]) %}
    {% endfor %}
    <header class="nowo-ui-header" data-testid="demo-masthead">
        <a class="nowo-ui-brand" href="{{ path('form_demo_index', {_locale: locale}) }}">{{ 'demo_nav.brand'|trans }}</a>
        {% if route %}
        <nav class="nowo-ui-menu" aria-label="{{ 'demo_nav.brand'|trans }}">
            {% for item in [
                {route: 'form_demo_form_type', label: 'demo_nav.form_type'},
                {route: 'form_demo_controller_form', label: 'demo_nav.controller_form'},
                {route: 'form_demo_search', label: 'demo_nav.search'},
                {route: 'form_demo_example_form', label: 'demo_nav.example'},
                {route: 'form_demo_dropzone', label: 'demo_nav.dropzone'},
                {route: 'form_demo_cropper', label: 'demo_nav.cropper'},
                {route: 'form_demo_translations', label: 'demo_nav.translations'},
                {route: 'form_demo_locale_tabs', label: 'demo_nav.locale_tabs'},
                {route: 'form_demo_nested', label: 'demo_nav.nested'},
                {route: 'form_demo_data_transformers', label: 'demo_nav.data_transformers'},
                {route: 'form_demo_choice_fields', label: 'demo_nav.choice_fields'},
                {route: 'form_demo_conditional_fields', label: 'demo_nav.conditional_fields'},
                {route: 'form_demo_conditional_fields_live', label: 'demo_nav.conditional_fields_live'},
                {route: 'form_demo_kit_api_patterns', label: 'demo_nav.kit_api_patterns'},
                {route: 'form_demo_nowo_special_fields', label: 'demo_nav.nowo_special_fields'},
                {route: 'form_demo_ckeditor', label: 'demo_nav.ckeditor'},
                {route: 'form_demo_ux_autocomplete', label: 'demo_nav.ux_autocomplete'},
                {route: 'form_demo_multistep', label: 'demo_nav.multi_step'},
            ] %}
                <a class="nowo-ui-link" href="{{ path(item.route, {_locale: locale}) }}"{% if route == item.route %} aria-current="page"{% endif %}>{{ item.label|trans }}</a>
            {% endfor %}
        </nav>
        {% endif %}
        <div class="nowo-ui-header__end">
            {{ include('@NowoUiKitBundle/partials/_locale_switcher.html.twig', { locales: _locales, current: locale, compact: true }, false) }}
            {{ include('@NowoUiKitBundle/partials/_theme_toggle.html.twig', { compact: true }, false) }}
        </div>
    </header>
{% endblock %}

{% block nowo_ui_content %}{% block body %}{% endblock %}{% endblock %}

{% block nowo_ui_scripts %}
    {{ parent() }}
    {# Form Kit HelpModalExtension: icons + modals for label[data-nowo-help-modal]. Shell markup from Twig (override per framework in templates/bundles/NowoFormKitBundle/help_modal/). #}
    {% include '@NowoFormKitBundle/help_modal/shells.html.twig' %}
    <script defer src="{{ asset('help-modal.js', 'nowo_form_kit') }}"></script>
    {% block importmap %}{{ importmap('ux') }}{% endblock %}
    {{ vite_entry_script_tags('app') }}
    {# Standalone Nowo / UX bundle scripts must load after importmap (Stimulus) so hashed /assets/* entrypoints stay in sync. #}
    <script defer src="{{ asset(nowo_select_all_choice_asset_path('select-all-choice.js'), nowo_select_all_choice_asset_package()) }}"></script>
    {% block page_scripts %}{% endblock %}
{% endblock %}
