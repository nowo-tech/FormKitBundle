{#- REQ-DEMO-014: the demo runs inside UiKit's shared demo platform shell. This file declares the demo and gives every page
    its page header: a page sets `demo_page` (the demo_pages.<key> translations) at the top level, and `demo_flash` for fixed
    flash messages (plain text). The Form Kit help modal uses its self-contained shell. -#}
{% extends '@NowoUiKit/demo_platform/layout.html.twig' %}
{% set _locale = app.request.locale|default('en') %}
{% set nowo_ui_demo_platform = {
    bundle: 'Form Kit',
    home_route: 'form_demo_index',
    home_params: {_locale: _locale},
    repository: 'https://github.com/nowo-tech/FormKitBundle',
    translation_domain: 'messages',
    locales: demo_enabled_locales,
    nav: [
        {label: 'demo_nav.home', route: 'form_demo_index', params: {_locale: _locale}, section: 'Demo'},
        {label: 'demo_nav.form_type', route: 'form_demo_form_type', params: {_locale: _locale}, section: 'Basics'},
        {label: 'demo_nav.controller_form', route: 'form_demo_controller_form', params: {_locale: _locale}, section: 'Basics'},
        {label: 'demo_nav.search', route: 'form_demo_search', params: {_locale: _locale}, section: 'Basics'},
        {label: 'demo_nav.example', route: 'form_demo_example_form', params: {_locale: _locale}, section: 'Basics'},
        {label: 'demo_nav.nested', route: 'form_demo_nested', params: {_locale: _locale}, section: 'Data and layout'},
        {label: 'demo_nav.data_transformers', route: 'form_demo_data_transformers', params: {_locale: _locale}, section: 'Data and layout'},
        {label: 'demo_nav.choice_fields', route: 'form_demo_choice_fields', params: {_locale: _locale}, section: 'Data and layout'},
        {label: 'demo_nav.conditional_fields', route: 'form_demo_conditional_fields', params: {_locale: _locale}, section: 'Data and layout'},
        {label: 'demo_nav.conditional_fields_live', route: 'form_demo_conditional_fields_live', params: {_locale: _locale}, section: 'Data and layout'},
        {label: 'demo_nav.kit_api_patterns', route: 'form_demo_kit_api_patterns', params: {_locale: _locale}, section: 'Data and layout'},
        {label: 'demo_nav.multi_step', route: 'form_demo_multistep', params: {_locale: _locale}, section: 'Data and layout'},
        {label: 'demo_nav.translations', route: 'form_demo_translations', params: {_locale: _locale}, section: 'Translations'},
        {label: 'demo_nav.locale_tabs', route: 'form_demo_locale_tabs', params: {_locale: _locale}, section: 'Translations'},
        {label: 'demo_nav.dropzone', route: 'form_demo_dropzone', params: {_locale: _locale}, section: 'Widgets'},
        {label: 'demo_nav.cropper', route: 'form_demo_cropper', params: {_locale: _locale}, section: 'Widgets'},
        {label: 'demo_nav.nowo_special_fields', route: 'form_demo_nowo_special_fields', params: {_locale: _locale}, section: 'Widgets'},
        {label: 'demo_nav.ckeditor', route: 'form_demo_ckeditor', params: {_locale: _locale}, section: 'Widgets'},
        {label: 'demo_nav.ux_autocomplete', route: 'form_demo_ux_autocomplete', params: {_locale: _locale}, section: 'Widgets'},
    ],
} %}
{% block nowo_ui_document_title %}{% block title %}{{ 'demo_pages.layout.default_title'|trans }}{% endblock %}{% endblock %}

{% block nowo_ui_head %}
    {# Form Kit help modal: per-request nonce that binds label[data-nowo-help-modal] payloads to this page (REQ-SEC-004). #}
    {{ nowo_form_kit_help_modal_meta() }}
{% endblock %}

{% block nowo_ui_styles %}
    {{ parent() }}
    {{ vite_entry_link_tags('app') }}
    {% block stylesheets %}{% endblock %}
{% endblock %}

{% block nowo_ui_page_header %}
    {% if demo_page is defined %}
        {% set _toolbar %}
            {% if demo_page != 'index' %}<a class="nowo-ui-btn nowo-ui-btn--outline" href="{{ path('form_demo_index', {_locale: _locale}) }}">{{ 'demo_pages.common.back'|trans }}</a>{% endif %}
        {% endset %}
        {% set _intro_key = 'demo_pages.' ~ demo_page ~ '.intro' %}
        {% set _intro = _intro_key|trans %}
        {{ include(nowo_ui_partial('page_header'), {
            title: ('demo_pages.' ~ demo_page ~ '.' ~ (demo_page == 'index' ? 'title' : 'heading'))|trans,
            intro: _intro == _intro_key ? null : _intro|striptags|raw,
            toolbar: _toolbar|trim,
        }) }}
    {% endif %}
{% endblock %}

{% block nowo_ui_flashes %}
    {{ include('@NowoUiKit/demo_platform/_flashes.html.twig', {flash_messages: demo_flash|default(null)}) }}
{% endblock %}

{% block nowo_ui_scripts %}
    {{ parent() }}
    {# Form Kit HelpModalExtension: icons + modals for label[data-nowo-help-modal]. Shell markup from Twig (override per framework in templates/bundles/NowoFormKitBundle/help_modal/). #}
    {% include '@NowoFormKitBundle/help_modal/shells.html.twig' %}
    <script defer src="{{ asset('help-modal.js', 'nowo_form_kit') }}"></script>
    {% block importmap %}{{ importmap('ux') }}{% endblock %}
    {{ vite_entry_script_tags('app') }}
    {# Standalone Nowo / UX bundle scripts must load after importmap (Stimulus) so hashed /assets/* entrypoints stay in sync. #}
    <script defer src="{{ asset(nowo_select_all_choice_asset_path('select-all-choice.js'), nowo_select_all_choice_asset_package()) }}"></script>
    {% block page_scripts %}{% endblock %}
{% endblock %}
