<div{{ attributes }}>
  {{ form_start(form, {attr: {class: 'nowo-ui-form'}}) }}
  {% for child in form %}
    {% if not child.rendered %}
      {{ form_row(child) }}
    {% endif %}
  {% endfor %}
  <div class="nowo-ui-form__actions">
    <button type="submit" class="nowo-ui-btn nowo-ui-btn--outline">{{ 'demo_pages.common.submit'|trans }}</button>
  </div>
  {{ form_end(form) }}
</div>
