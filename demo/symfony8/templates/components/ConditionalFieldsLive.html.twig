<div{{ attributes }}>
  <p class="small text-secondary mb-3">{{ 'demo_pages.conditional_fields_live.component_intro'|trans|raw }}</p>
  {{ form_start(form) }}
  {% set columns = {first_name: 'col-12 col-md-6', last_name: 'col-12 col-md-6'} %}
  <div class="row g-3">
    {% for child in form %}
      {% if not child.rendered %}
        {% if 'hidden' in child.vars.block_prefixes %}
          {{ form_row(child) }}
        {% else %}
          <div class="{{ columns[child.vars.name]|default('col-12') }}">{{ form_row(child) }}</div>
        {% endif %}
      {% endif %}
    {% endfor %}
  </div>
  <div class="form-kit-buttons mt-3">
    <button type="submit" class="btn btn-primary">{{ 'demo_pages.common.submit'|trans }}</button>
  </div>
  {{ form_end(form) }}
</div>
