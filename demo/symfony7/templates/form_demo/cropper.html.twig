{% extends 'base.html.twig' %}

{% block title %}{{ 'demo_pages.cropper.page_title'|trans }}{% endblock %}

{% block body %}
{% set locale = app.request.locale %}
<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="h3 mb-0">{{ 'demo_pages.cropper.heading'|trans }}</h1>
  <a class="btn btn-sm btn-outline-secondary" href="{{ path('form_demo_index', {_locale: locale}) }}">{{ 'demo_pages.common.back'|trans }}</a>
</div>
<p class="text-secondary mb-4">{{ 'demo_pages.cropper.intro'|trans|raw }}</p>

{% if not sample_exists %}
  <div class="alert alert-warning shadow-sm">
    <strong>{{ 'demo_pages.cropper.sample_missing_title'|trans }}</strong> {{ 'demo_pages.cropper.sample_missing_body'|trans|raw }}
  </div>
  <p class="text-muted small">{{ 'demo_pages.cropper.expected_path'|trans }} <code>{{ image_path }}</code></p>
{% else %}
  <div class="card form-card shadow-sm">
    <div class="card-body p-4">
      {{ form_start(form) }}
      {{ form_row(form.crop) }}
      {% set form_buttons %}
        <button type="submit" class="btn btn-primary">{{ 'demo_pages.common.crop'|trans }}</button>
      {% endset %}
      <div class="form-kit-buttons">{{ form_buttons|raw }}</div>
      {{ form_end(form, { render_rest: false }) }}
    </div>
  </div>

  {% if submitted %}
    <div class="alert alert-success mt-4 mb-0 shadow-sm">
      <strong>{{ 'demo_pages.cropper.crop_submitted_title'|trans }}</strong> {{ 'demo_pages.cropper.crop_submitted_body'|trans|raw }}
    </div>
  {% endif %}
{% endif %}
{% endblock %}
