{% extends 'base.html.twig' %}

{% block title %}{{ 'demo_pages.search.page_title'|trans }}{% endblock %}

{% block body %}
{% set locale = app.request.locale %}
<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="h3 mb-0">{{ 'demo_pages.search.heading'|trans }}</h1>
  <a class="btn btn-sm btn-outline-secondary" href="{{ path('form_demo_index', {_locale: locale}) }}">{{ 'demo_pages.common.back'|trans }}</a>
</div>
<p class="text-secondary mb-4">{{ 'demo_pages.search.intro'|trans|raw }}</p>

<div class="card search-bar-card shadow-sm">
  <div class="card-body p-4">
    {{ form_start(form) }}
    <label for="{{ form.q.vars.id }}" class="form-label small text-muted mb-2">{{ 'search_form.q.label'|trans }}</label>
    <div class="input-group input-group-lg">
      {{ form_widget(form.q, { attr: { class: 'form-control', 'aria-label': ('demo_pages.search.aria_query'|trans) } }) }}
      <span class="input-group-text bg-light border-start-0 border-end-0 px-3">{{ 'demo_pages.search.in_word'|trans }}</span>
      {{ form_widget(form.category, { attr: { class: 'form-select flex-grow-0', style: 'max-width: 11rem;', 'aria-label': ('demo_pages.search.aria_category'|trans) } }) }}
      <button type="submit" class="btn btn-primary px-4">{{ 'demo_pages.search.button_submit'|trans }}</button>
    </div>
    <div class="d-flex flex-wrap gap-3 mt-2">
      {{ form_errors(form.q) }}
      {{ form_errors(form.category) }}
      {% if form.category.vars.help is defined and form.category.vars.help %}
        <small class="text-muted">{{ form.category.vars.help }}</small>
      {% endif %}
    </div>
    {% for child in form %}
      {% if child.vars.name == '_token' %}
        {{ form_row(child) }}
      {% endif %}
    {% endfor %}
    {{ form_end(form, { render_rest: false }) }}
  </div>
</div>

{% if submitted %}
  <div class="alert alert-info mt-4 mb-0 shadow-sm">
    <strong>{{ 'demo_pages.common.submitted'|trans }}:</strong>
    q = <code>{{ submitted.q }}</code>, category = <code>{{ submitted.category }}</code>
  </div>
{% endif %}
{% endblock %}
