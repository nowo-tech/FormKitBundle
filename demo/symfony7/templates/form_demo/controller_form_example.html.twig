{% extends 'base.html.twig' %}

{% block title %}{{ 'demo_pages.controller_form.page_title'|trans }}{% endblock %}

{% block body %}
{% set locale = app.request.locale %}
<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="h3 mb-0">{{ 'demo_pages.controller_form.heading'|trans }}</h1>
  <a class="btn btn-sm btn-outline-secondary" href="{{ path('form_demo_index', {_locale: locale}) }}">{{ 'demo_pages.common.back'|trans }}</a>
</div>
<p class="text-secondary mb-4">{{ 'demo_pages.controller_form.intro'|trans|raw }}</p>

<div class="alert alert-light border mb-4">
  <strong class="d-block mb-2">{{ 'demo_pages.common.bundle_usage'|trans }}</strong>
  <ul class="mb-0 small text-secondary">
    <li>{{ 'demo_pages.controller_form.usage_1'|trans|raw }}</li>
    <li>{{ 'demo_pages.controller_form.usage_2'|trans|raw }}</li>
    <li>{{ 'demo_pages.controller_form.usage_3'|trans|raw }}</li>
  </ul>
</div>

<div class="card form-card shadow-sm">
  <div class="card-body p-4">
    {% include 'form_demo/_form_unrendered_loop.html.twig' with { demo_form: form, wrapper_class: 'row g-3', submit_label: 'demo_pages.common.submit'|trans } only %}
  </div>
</div>
{% endblock %}
