{% extends 'base.html.twig' %}

{% block title %}{{ 'demo_pages.translations.page_title'|trans }}{% endblock %}

{% block body %}
{% set locale = app.request.locale %}
<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="h3 mb-0">{{ 'demo_pages.translations.heading'|trans }}</h1>
  <a class="btn btn-sm btn-outline-secondary" href="{{ path('form_demo_index', {_locale: locale}) }}">{{ 'demo_pages.common.back'|trans }}</a>
</div>
<p class="text-secondary mb-4">{{ 'demo_pages.translations.intro'|trans|raw }}</p>
{% if demo_translation_context is defined %}
  <div class="alert alert-light border mb-4 small">
    <p class="mb-2">{{ 'demo_pages.translations.locale_pool_hint'|trans({'%pool%': demo_translation_context.enabled_locales|join(', ')}) }}</p>
    <a class="btn btn-sm btn-outline-primary" href="{{ path('form_demo_translations', {_locale: locale, reshuffle: 1}) }}">{{ 'demo_pages.translations.reshuffle'|trans }}</a>
  </div>
{% endif %}

<div class="card form-card shadow-sm rounded-3">
  <div class="card-body p-4">
    {{ form_start(form) }}
    {% set translations_form = form.translations %}
    <ul class="nav nav-tabs border-0 border-bottom mb-0 px-0" id="translations-tab" role="tablist">
      {% for locale_key, localeForm in translations_form %}
        <li class="nav-item" role="presentation">
          <button class="nav-link rounded-0 border-0 py-3 px-3 {{ loop.first ? 'active' }}" id="tab-{{ locale_key }}" data-bs-toggle="tab" data-bs-target="#pane-{{ locale_key }}" type="button" role="tab" aria-controls="pane-{{ locale_key }}" aria-selected="{{ loop.first ? 'true' : 'false' }}">{{ localeForm.vars.label|default(locale_key) }}</button>
        </li>
      {% endfor %}
    </ul>
    <div class="tab-content pt-4" id="translations-tab-content">
      {% for locale_key, localeForm in translations_form %}
        <div class="tab-pane fade {{ loop.first ? 'show active' }}" id="pane-{{ locale_key }}" role="tabpanel" aria-labelledby="tab-{{ locale_key }}">
          <div class="mb-3">
            {{ form_row(localeForm.title) }}
          </div>
          <div class="mb-0">
            {{ form_row(localeForm.description) }}
          </div>
        </div>
      {% endfor %}
    </div>
    <div class="form-kit-buttons mt-4 pt-3 border-top">
      <button type="submit" class="btn btn-primary rounded-2 px-4">{{ 'demo_pages.common.save'|trans }}</button>
    </div>
    {{ form_end(form, { render_rest: false }) }}
  </div>
</div>

{% if submitted %}
  <div class="alert alert-success mt-4 mb-0 shadow-sm rounded-3">
    <strong>{{ 'demo_pages.common.submitted'|trans }}:</strong>
    <pre class="mb-0 small">{% for loc, t in submitted.translations %}{{ loc }}: {{ t.title }} — {{ t.description }}{{ "\n" }}{% endfor %}</pre>
  </div>
{% endif %}
{% endblock %}
