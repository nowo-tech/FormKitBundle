{% extends 'base.html.twig' %}

{% block title %}{{ 'demo_pages.example.page_title'|trans }}{% endblock %}

{% block body %}
{% set locale = app.request.locale %}
<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="h3 mb-0">{{ 'demo_pages.example.heading'|trans }}</h1>
  <a class="btn btn-sm btn-outline-secondary" href="{{ path('form_demo_index', {_locale: locale}) }}">{{ 'demo_pages.common.back'|trans }}</a>
</div>
<p class="text-secondary mb-4">{{ 'demo_pages.example.intro'|trans|raw }}</p>

<div class="card form-card shadow-sm">
  <div class="card-body p-4">
    {% set submit_buttons %}
      <button type="submit" name="action" value="send" class="btn btn-success">{{ 'demo_pages.example.send'|trans }}</button>
      <button type="submit" name="action" value="send_copy" class="btn btn-outline-secondary">{{ 'demo_pages.example.send_copy'|trans }}</button>
    {% endset %}
    {% include 'form_demo/_form_unrendered_loop.html.twig' with { demo_form: form, wrapper_class: 'row g-3', submit_buttons: submit_buttons } only %}
  </div>
</div>

{% if submitted %}
  <div class="alert alert-success mt-4 mb-0 shadow-sm">
    <strong>{{ 'demo_pages.common.submitted'|trans }}:</strong>
    {{ 'demo_pages.example.submitted_line'|trans({ '%name%': submitted.name, '%email%': submitted.email, '%subject%': submitted.subject }) }}
  </div>
{% endif %}
{% endblock %}
