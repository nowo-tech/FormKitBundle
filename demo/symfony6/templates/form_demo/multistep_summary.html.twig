{% extends 'base.html.twig' %}

{% block title %}{{ 'demo_pages.multistep_summary.page_title'|trans }}{% endblock %}

{% block body %}
{% set locale = app.request.locale %}
<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="h3 mb-0">{{ 'demo_pages.multistep_summary.heading'|trans }}</h1>
  <a class="btn btn-sm btn-outline-secondary" href="{{ path('form_demo_index', {_locale: locale}) }}">{{ 'demo_pages.common.back'|trans }}</a>
</div>

<div class="card form-card shadow-sm">
  <div class="card-body p-4">
    <h2 class="h5 mb-3">{{ 'demo_pages.common.collected_data'|trans }}</h2>
    <dl class="row mb-0">
      {% for key, value in wizard.collectedDataFlat %}
        <dt class="col-sm-3 text-muted">{{ key }}</dt>
        <dd class="col-sm-9">{{ value }}</dd>
      {% endfor %}
    </dl>
    <hr class="my-4">
    <a href="{{ path('form_demo_multistep', {_locale: locale}) }}?reset=1" class="btn btn-outline-primary">{{ 'demo_pages.common.start_over'|trans }}</a>
  </div>
</div>
{% endblock %}
