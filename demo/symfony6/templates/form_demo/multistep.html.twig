{% extends 'base.html.twig' %}

{% block title %}{{ 'demo_pages.multistep.page_title'|trans }}{% endblock %}

{% block body %}
{% set locale = app.request.locale %}
<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="h3 mb-0">{{ 'demo_pages.multistep.heading'|trans }}</h1>
  <a class="btn btn-sm btn-outline-secondary" href="{{ path('form_demo_index', {_locale: locale}) }}">{{ 'demo_pages.common.back'|trans }}</a>
</div>
<p class="text-secondary mb-4">{{ 'demo_pages.multistep.intro'|trans|raw }}</p>

<div class="card form-card shadow-sm">
  <div class="card-body p-4">
    <ul class="nav nav-pills nav-fill mb-4">
      {% for key in wizard.stepKeys %}
        <li class="nav-item">
          <span class="nav-link {{ key == wizard.currentStepKey ? 'active' : '' }} {{ loop.index0 < wizard.currentIndex ? 'text-success' : '' }}">
            {{ loop.index }}. {{ ('demo_wizard_nav.' ~ key)|trans }}
          </span>
        </li>
      {% endfor %}
    </ul>

    {{ form_start(form) }}
    <div class="row g-3">
      {% for child in form %}
        <div class="col-12">{{ form_row(child) }}</div>
      {% endfor %}
    </div>
    <div class="form-kit-buttons">
      <button type="submit" class="btn btn-primary">{{ wizard.currentIndex + 1 >= wizard.stepKeys|length ? ('demo_pages.common.finish'|trans) : ('demo_pages.common.next'|trans) }}</button>
    </div>
    {{ form_end(form, { render_rest: false }) }}
  </div>
</div>
{% endblock %}
