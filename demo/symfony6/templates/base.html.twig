<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}{{ 'demo_pages.layout.default_title'|trans }}{% endblock %}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    {{ vite_entry_link_tags('app') }}
</head>
<body>
{% set route = app.request.attributes.get('_route') %}
{% set locale = app.request.locale %}
{% set route_params = app.request.attributes.get('_route_params')|default({}) %}
<nav class="navbar navbar-expand-lg bg-white border-bottom shadow-sm">
    <div class="container">
        <a class="navbar-brand demo-navbar-brand" href="{{ path('form_demo_index', {_locale: locale}) }}">{{ 'demo_nav.brand'|trans }}</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar" aria-controls="mainNavbar" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="mainNavbar">
            <ul class="navbar-nav ms-auto mb-2 mb-lg-0 align-items-lg-center flex-wrap">
                {% if route %}
                <li class="nav-item"><a class="nav-link" href="{{ path('form_demo_form_type', {_locale: locale}) }}">{{ 'demo_nav.form_type'|trans }}</a></li>
                <li class="nav-item"><a class="nav-link" href="{{ path('form_demo_controller_form', {_locale: locale}) }}">{{ 'demo_nav.controller_form'|trans }}</a></li>
                <li class="nav-item"><a class="nav-link" href="{{ path('form_demo_search', {_locale: locale}) }}">{{ 'demo_nav.search'|trans }}</a></li>
                <li class="nav-item"><a class="nav-link" href="{{ path('form_demo_example_form', {_locale: locale}) }}">{{ 'demo_nav.example'|trans }}</a></li>
                <li class="nav-item"><a class="nav-link" href="{{ path('form_demo_dropzone', {_locale: locale}) }}">{{ 'demo_nav.dropzone'|trans }}</a></li>
                <li class="nav-item"><a class="nav-link" href="{{ path('form_demo_cropper', {_locale: locale}) }}">{{ 'demo_nav.cropper'|trans }}</a></li>
                <li class="nav-item"><a class="nav-link" href="{{ path('form_demo_translations', {_locale: locale}) }}">{{ 'demo_nav.translations'|trans }}</a></li>
                <li class="nav-item"><a class="nav-link" href="{{ path('form_demo_nested', {_locale: locale}) }}">{{ 'demo_nav.nested'|trans }}</a></li>
                <li class="nav-item"><a class="nav-link" href="{{ path('form_demo_data_transformers', {_locale: locale}) }}">{{ 'demo_nav.data_transformers'|trans }}</a></li>
                <li class="nav-item"><a class="nav-link" href="{{ path('form_demo_choice_fields', {_locale: locale}) }}">{{ 'demo_nav.choice_fields'|trans }}</a></li>
                <li class="nav-item"><a class="nav-link" href="{{ path('form_demo_ckeditor', {_locale: locale}) }}">{{ 'demo_nav.ckeditor'|trans }}</a></li>
                <li class="nav-item"><a class="nav-link" href="{{ path('form_demo_ux_autocomplete', {_locale: locale}) }}">{{ 'demo_nav.ux_autocomplete'|trans }}</a></li>
                <li class="nav-item"><a class="nav-link" href="{{ path('form_demo_multistep', {_locale: locale}) }}">{{ 'demo_nav.multi_step'|trans }}</a></li>
                {% endif %}
                <li class="nav-item dropdown ms-lg-2">
                    <a class="nav-link dropdown-toggle" href="#" id="demoLocaleDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                        {{ 'demo_nav.locale'|trans }}: <strong>{{ app.request.locale|upper }}</strong>
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="demoLocaleDropdown">
                        {% for loc in demo_enabled_locales %}
                            {% if route %}
                                <li><a class="dropdown-item{% if app.request.locale == loc %} active{% endif %}" href="{{ path(route, route_params|merge({_locale: loc})) }}">{{ loc|upper }}</a></li>
                            {% else %}
                                <li><a class="dropdown-item{% if app.request.locale == loc %} active{% endif %}" href="{{ path('form_demo_index', {_locale: loc}) }}">{{ loc|upper }}</a></li>
                            {% endif %}
                        {% endfor %}
                    </ul>
                </li>
            </ul>
        </div>
    </div>
</nav>

<main class="container py-4">
    {% block body %}{% endblock %}
</main>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
{# Form Kit HelpModalExtension: icons + modals for label[data-nowo-help-modal]. Shell markup from Twig (override per framework in templates/bundles/NowoFormKitBundle/help_modal/). #}
{% include '@NowoFormKit/help_modal/shells.html.twig' %}
<script defer src="{{ asset('/bundles/nowoformkit/help-modal.js') }}"></script>
{% block importmap %}{{ importmap('ux') }}{% endblock %}
{{ vite_entry_script_tags('app') }}
</body>
</html>
