# PHPStan configuration for Form Kit Bundle
# Compatible with PHP 8.2+ and Symfony 7.4 / 8.x

includes:
    - phpstan-baseline.neon
    - vendor/nowo-tech/phpstan-frankenphp/ruleset-classic.neon
    - vendor/nowo-tech/phpstan-frankenphp/ruleset-worker.neon

parameters:
    level: 8
    paths:
        - src
        - tests
    scanFiles:
        - stubs/OptionalFormTypes.php
    excludePaths:
        - demo/*
        # Optional A2lix integration (suggest-only dependency).
        - src/Form/Type/TranslationsFormsType.php
